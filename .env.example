# 知镜 · 运行配置
# 复制为 .env.local 后填入，npm start 会自动读取（需要 Node >= 22.9）
# 不配置也能跑：默认使用 data/ 下的离线快照（精选样本模式）

# 知乎开放平台 Access Secret（Bearer）。仅存服务端，禁止写入仓库/前端/日志/截图/视频
ZHIHU_ACCESS_SECRET=

# 兼容 OpenAI Chat Completions 的模型服务（自有 One API 中转）
# 基础地址指向根路径，例如 https://your-provider.example/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 可选：原样并入模型请求体的 JSON 对象，用于服务商私有参数。不能覆盖 model、messages、response_format。
# 思考型模型必须关闭思考，否则会超过单次 25 秒上限：
#   deepseek：{"thinking":{"type":"disabled"}}    qwen：{"enable_thinking":false}
AI_EXTRA_BODY=
# 可选：主模型上游卡住（超时、5xx、429、网络错误）时自动改用的备用模型，并在 5 分钟内优先走它；建议选另一家服务商的模型
AI_FALLBACK_MODEL=

# 仅本地/受控内部联调启用。只开放 liveStatus=pilot 的话题，不等于效果已验收。
ZHIJING_ENABLE_PILOT=0

# 知乎登录（OAuth）：项目创建后在赛事页面领取 App ID / App Key。App Key 只放服务端。
# 回调地址必须与赛事页面登记值完全一致（协议、域名、路径、尾部斜杠）。三项缺一则登录关闭，页面不显示登录按钮。
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=https://zhijing.vortotech.com/auth/callback

# 进程内预算（重启清零；不是知乎平台额度）：每天最多触发多少次真正的实时检索+模型分析（缓存命中不计），超出返回 429
ZHIJING_LIVE_DAILY_LIMIT=200
# 决策陪伴、找同路人等模型调用的每日任务次数
ZHIJING_ADVICE_DAILY_LIMIT=600

# 服务监听（默认只监听本机）
PORT=4318
HOST=127.0.0.1
