# 知镜 · 运行配置
# 复制为 .env.local 后填入，用 node --env-file=.env.local src/server.mjs 启动
# 不配置也能跑：默认使用 data/ 下的离线快照（精选样本模式）

# 知乎开放平台 Access Secret（Bearer）。仅存服务端，禁止写入仓库/前端/日志/截图/视频
ZHIHU_ACCESS_SECRET=

# 兼容 OpenAI Chat Completions 的模型服务（自有 One API 中转）
# 基础地址指向根路径，例如 https://your-provider.example/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 可选：原样并入模型请求体的 JSON 对象，用于服务商私有参数。不能覆盖 model、messages、response_format。
# 思考型模型必须关闭思考，否则会超过单次 25 秒上限：
#   deepseek：{"thinking":{"type":"disabled"}}    qwen：{"enable_thinking":false}
AI_EXTRA_BODY=

# 仅本地/受控内部联调启用。只开放 liveStatus=pilot 的话题，不等于效果已验收。
ZHIJING_ENABLE_PILOT=0

# 服务监听（默认只监听本机）
PORT=4318
HOST=127.0.0.1
